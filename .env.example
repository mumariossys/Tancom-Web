# LOCAL CONFIGURATION ONLY. Copy to .env; never commit actual values.
# Root tools load .env using Node's env-file support.
# Public values are bundled into browser JavaScript; never put secrets in VITE_*.
BASE_PATH=/
WEB_PORT=5174
API_PORT=8080
NODE_ENV=development
LOG_LEVEL=info
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
# The original Vite config derives VITE_LIVEKIT_URL from LIVEKIT_URL below.

# Backend only: use a NEW local disposable database, not the live database.
DATABASE_URL=
MIGRATE_DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PROXY_URL=
CLERK_API_URL=
REPLIT_DOMAINS=
# Explicit acknowledgement for the guarded local dev:api convenience command.
# See README; raw API commands bypass this export-only guard.
TANCOM_ALLOW_LOCAL_BACKEND_START=

# LiveKit / recordings: empty until independently approved test services exist.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EGRESS_S3_ENDPOINT=
EGRESS_S3_REGION=
EGRESS_S3_BUCKET=
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET_KEY=

# Current app storage requires Replit's credential sidecar: NOT portable as-is.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional service integrations. Never use live sending credentials for tests.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Desktop companion; set explicitly when testing it. Does not relink live apps.
TANCOM_URL=
