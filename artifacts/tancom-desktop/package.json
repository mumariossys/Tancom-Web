{
  "name": "@workspace/tancom-desktop",
  "version": "1.0.0",
  "description": "TanCom Desktop — native Electron wrapper with true remote control",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:all": "npm run build && electron-builder --win --mac"
  },
  "dependencies": {
    "robotjs": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "node-abi": "3.101.0"
  },
  "build": {
    "extends": null,
    "appId": "us.tancom.desktop",
    "productName": "TanCom",
    "copyright": "Copyright © 2026 TanCom",
    "asar": false,
    "directories": {
      "output": "packaging-out"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/mac{,-arm64,-x64,-universal}{,/**/*}",
      "!dist/*-unpacked{,/**/*}",
      "!**/*.framework{,/**/*}",
      "assets/**/*",
      "!node_modules/electron{,/**/*}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "TanCom ${version}",
      "background": "assets/dmg-background.png",
      "window": { "width": 540, "height": 380 }
    }
  }
}
